                "name": "customerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "clientId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Merchant"
        },
