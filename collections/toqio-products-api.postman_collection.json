      "item": [
        {
          "id": "6c9a6d02-1775-446b-a2b1-a005c41767a8",
          "name": "Notify product changes for a customer",
          "request": {
            "name": "Notify product changes for a customer",
            "description": {
              "content": "This endpoint is called by Integration Hub to notify downstream banking provider systems about product changes that occurred in the Wallet system. The endpoint should be implemented by third-party banking providers to receive and process product change notifications.\n\nWhen this endpoint is called, it indicates that products associated with a customer have been modified in the Wallet system and need to be synchronized in the banking provider's system. The notification can contain:\n\n- **Products to upsert**: A list of products that should be created if they don't exist, or updated if they already exist in the provider's system. Each product contains complete information including account details, balances, status, and metadata.\n\n- **Products to delete**: A list of product IDs that should be removed from the provider's system. These are products that have been deleted or deactivated in the Wallet and should no longer be accessible.\n\nThe provider system receiving this notification should:\n1. Validate that the customerId corresponds to an existing customer in their system\n2. Process all product upserts by creating new products or updating existing ones based on the product ID\n3. Process all product deletions by removing or deactivating the specified products\n4. Return a successful response (HTTP 200) if all operations completed successfully\n5. Return an error response (HTTP 400/404) if validation fails or operations cannot be completed\n\nThe endpoint is idempotent - calling it multiple times with the same data should produce the same result. Product upserts should use the product ID as the unique identifier to determine whether to create or update.\n\nThis is a critical synchronization point to ensure consistency between Toqio and the integration products catalog for each customer.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "customers",
                ":customerId",
                "products",
                "changes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customerId",
                  "description": "(Required) The unique identifier of the customer in the banking provider's system. This ID must correspond to an existing customer record. All product changes in the request will be associated with this customer."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
