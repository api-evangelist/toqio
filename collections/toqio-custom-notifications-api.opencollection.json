{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account Custom Notifications API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Custom Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send custom notifications",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.toq.io/wallet/api/webhooks/integration/:integration/webhooktype/:type",
            "params": [
              {
                "name": "integration",
                "value": "",
                "type": "path"
              },
              {
                "name": "type",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Send custom notifications"
        },
        {
          "info": {
            "name": "Notify custom notification errors",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.toq.io/wallet/api/notifications/errors",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Notify custom notification errors"
        },
        {
          "info": {
            "name": "Send Email Notification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.toq.io/wallet/api/notifications/email/send",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send Email Notification"
        }
      ]
    }
  ],
  "bundled": true
}