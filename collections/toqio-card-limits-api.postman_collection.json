        {
          "id": "18254c93-41fd-42e1-bdb5-c0e09eb497b6",
          "name": "Get available card limit types",
          "request": {
            "name": "Get available card limit types",
            "description": {
              "content": "Retrieves the list of available card limit types configured in the system. Use this endpoint to discover which custom limits can be set when creating or updating cards.\n\n**Business Context**: Called to dynamically discover which limit fields are available for configuration. This allows the frontend UI to adapt to different banking provider capabilities and custom limit configurations.\n\n**Note**: The response includes all supported limit types, but the integration is not required to return all of them. Only return the limits that are actually configured in your system. Any limit not included in the response will be interpreted as null and ignored.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "customers",
                ":customerId",
                "availableCardLimits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customerId",
                  "description": "(Required) Unique identifier of the customer"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
