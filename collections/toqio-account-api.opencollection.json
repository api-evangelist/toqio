        {
          "info": {
            "name": "Get Dynamic Account Balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/accounts/:accountId/dynamicBalances",
            "params": [
              {
                "name": "customerId",
                "value": "customer_123",
                "type": "path",
                "description": "Unique identifier of the customer in the Toqio platform. This ID is used to identify which customer's account balances are being requested."
              },
              {
                "name": "accountId",
                "value": "acc_456",
                "type": "path",
                "description": "Unique identifier of the ledger account for which dynamic balances are being requested. This is the account ID from your connector's system."
              }
            ]
          },
          "docs": "Retrieves dynamic balance entries for a specific ledger account. The balances returned by this endpoint REPLACE the standard balance display in the Toqio platform. Instead of showing the default two balance fields, the platform will display exactly what the connector returns here. This allows complete customization of which balances are shown (e.g., available balance, pending balance, reserved amounts, etc.) and how they are labeled. IMPORTANT: If the connector returns an empty array or no respo"
        },
        {
          "info": {
            "name": "Get Payment Options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/accounts/:accountId/payment-options",
            "params": [
              {
                "name": "customerId",
                "value": "customer_123",
                "type": "path",
                "description": "Unique identifier of the customer in the Toqio platform. This is the customer who owns the source account and is initiating the payment flow."
              },
              {
                "name": "accountId",
                "value": "acc_456",
                "type": "path",
                "description": "Unique identifier of the source account from which the payment will be made. The connector should evaluate this account to determine which beneficiary selection mode applies."
              }
            ]
          },
          "docs": "Returns the payment options available for a specific source account. This endpoint is called by the Integration Hub before initiating a payment flow, so the frontend can determine how the user should select the destination beneficiary.\n\nThe main purpose of this endpoint is to communicate the **beneficiary selection mode**, which controls what kind of beneficiaries the user is allowed to choose as the destination of a payment originating from this account.\n\nThe connector must evaluate the source "
        }
