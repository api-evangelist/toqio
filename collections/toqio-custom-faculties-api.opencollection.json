            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              },
              {
                "name": "marketplaceKey",
                "value": "",
                "type": "path",
                "description": "marketplaceKey"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Custom Faculties"
        },
        {
          "info": {
            "name": "Update Custom faculties",
            "type": "http"
          },
          "http": {
