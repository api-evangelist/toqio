{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account Get Customer account information API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Get Customer account information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get accounts of the customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/accounts",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Allows to get the accounts of a customer"
        }
      ]
    }
  ],
  "bundled": true
}