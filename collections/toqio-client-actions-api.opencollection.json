{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account Client actions API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Client actions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete company",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/companies/:clientId",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint allows deleting a company. Only companies under 'Lead' and 'Rejected' status can be rejected"
        },
        {
          "info": {
            "name": "Freeze company",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/clients/:clientId/freeze",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allow to freeze a company"
        },
        {
          "info": {
            "name": "Reject company",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/clients/:clientId/reject",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              },
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint allows rejecting a company. Only companies under 'Onboarding', 'Live' and 'Quarantine' status can be rejected"
        },
        {
          "info": {
            "name": "Unfreeze company",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/clients/:clientId/unfreeze",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              }
            ]
          },
          "docs": "Allows to unfreeze a company"
        }
      ]
    }
  ],
  "bundled": true
}