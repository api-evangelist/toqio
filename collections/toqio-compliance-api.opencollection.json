      "items": [
        {
          "info": {
            "name": "Deletes a merchants KYB document",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.toq.io/wallet/api/iam/api/customers/:customerId/merchant/:clientId/provider/:complianceProvider/document/:documentKey",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "Toqios customer ID"
              },
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "Toqios client ID"
              },
              {
                "name": "complianceProvider",
                "value": "",
                "type": "path",
                "description": "The compliance provider the document is associated with"
              },
              {
                "name": "documentKey",
                "value": "",
                "type": "path",
                "description": "documentKey of the document to be deleted, provided when uploading using the pre-signed URL endpoint"
              },
              {
                "name": "documentId",
                "value": "",
                "type": "query",
                "description": "If the document was uploaded through the platform, a documentId is returned. This documentId is required to delete the document"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint will delete a KYB document previously uploaded through the platform or using pre-signed URL endpoint"
        },
