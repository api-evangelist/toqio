{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account User API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/clients/:clientId/users/:userId",
            "params": [
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              },
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "userId"
              }
            ]
          },
          "docs": "Allows to get the details of a given user"
        },
        {
          "info": {
            "name": "Create user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/clients/:clientId/users/create",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "clientId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Allows to create a user under a client "
        }
      ]
    }
  ],
  "bundled": true
}