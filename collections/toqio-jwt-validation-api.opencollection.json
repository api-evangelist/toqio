{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account JWT validation API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "JWT validation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate JWT token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/jwt/validate",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Validates a JWT token sent in the request body. Returns validation status and error message if invalid."
        }
      ]
    }
  ],
  "bundled": true
}