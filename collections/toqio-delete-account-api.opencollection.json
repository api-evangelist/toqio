{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Account Delete Account API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Delete Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Allows cancelling or removing a specified account. A cancelled account remains visible in the UI, while a removed account is no longer shown",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.toq.io/wallet/api/customers/:customerId/accounts/:accountId/merchant/:clientId/status/:accountStatus",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "customerId"
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "accountId"
              },
              {
                "name": "clientId",
                "value": "",
                "type": "path",
                "description": "clientId"
              },
              {
                "name": "accountStatus",
                "value": "",
                "type": "path",
                "description": "CANCELLED or DELETED"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.toq.io/iam/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Allows to cancel or delete a given account"
        }
      ]
    }
  ],
  "bundled": true
}